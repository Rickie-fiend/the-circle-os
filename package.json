{
  "name": "circle-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "next build",
    "start": "vinext start",
    "ai": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File local-ai/start-local-ai.ps1",
    "ai:phone": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File local-ai/setup-phone-ai.ps1",
    "chapters:check": "node scripts/chapter-compiler.mjs --check",
    "chapters:publish": "node scripts/chapter-compiler.mjs --publish",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "design:build": "node scripts/build-design-system.mjs",
    "design:check": "node scripts/build-design-system.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.14",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
