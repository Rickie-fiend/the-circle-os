{
  "type": "object",
  "required": ["sessions", "nextQuestion", "dailyMission"],
  "properties": {
    "sessions": {
      "type": "object",
      "required": [
        "typicalTuesday",
        "currentLife",
        "whatMatters",
        "gap",
        "missionStatement",
        "personality"
      ],
      "properties": {
        "typicalTuesday": { "$ref": "#/$defs/session" },
        "currentLife": { "$ref": "#/$defs/session" },
        "whatMatters": { "$ref": "#/$defs/session" },
        "gap": { "$ref": "#/$defs/session" },
        "missionStatement": { "$ref": "#/$defs/session" },
        "personality": { "$ref": "#/$defs/session" }
      }
    },
    "nextQuestion": {
      "anyOf": [
        {
          "type": "object",
          "required": ["text", "target"],
          "properties": {
            "text": { "type": "string" },
            "target": {
              "enum": [
                "typicalTuesday",
                "currentLife",
                "whatMatters",
                "gap",
                "missionStatement",
                "personality"
              ]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "dailyMission": { "type": "string" }
  },
  "$defs": {
    "session": {
      "type": "object",
      "required": ["text", "confidence"],
      "properties": {
        "text": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
